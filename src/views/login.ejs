<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Login | Dockuy' %></title>
    <link rel="stylesheet" href="/css/tailwind.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="min-h-screen bg-white flex items-center justify-center p-4 sm:p-6">

    <div class="w-full max-w-sm text-center">
        <!-- Minimal Branding -->
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-blue-600 tracking-tight">dockuy</h1>
            <p class="text-xs text-gray-400 mt-1">Single master password access</p>
        </div>

        <% if (error) { %>
            <div class="mb-5 p-3 bg-red-50 border border-red-200 text-red-600 rounded-xl text-xs font-medium text-left">
                <%= error %>
            </div>
        <% } %>

        <!-- Minimal Form (No Box) -->
        <form action="/api/login" method="POST" class="space-y-4 text-left">
            <div>
                <input 
                    type="password" 
                    id="password"
                    name="password" 
                    required
                    placeholder="Enter password..."
                    class="w-full px-4 py-3 bg-blue-50/40 border border-blue-200 rounded-xl text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 text-center"
                    autofocus
                />
            </div>

            <button 
                type="submit"
                class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white text-sm font-semibold rounded-xl transition-all duration-200"
            >
                Unlock Dashboard
            </button>
        </form>

        <div class="mt-8 text-xs text-gray-300">
            <span>Offline · Open Source</span>
        </div>
    </div>

</body>
</html>
