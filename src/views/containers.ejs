<%- include('partials/header') %>

<div class="space-y-6">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg text-sm">
            <%= error %>
        </div>
    <% } %>

    <!-- Containers Card -->
    <div class="bg-white rounded-xl border border-blue-100 shadow-sm overflow-hidden">
        <div class="px-4 sm:px-6 py-4 border-b border-blue-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-blue-900">Active & Inactive Containers</h2>
            <div class="flex items-center space-x-2">
                <button onclick="openModal('create')" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold flex items-center shadow-sm">
                    <svg width="16" height="16" class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create Container
                </button>
                <button onclick="window.location.reload()" class="px-3 py-1.5 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 text-sm font-medium">
                    Refresh
                </button>
            </div>
        </div>
        
        <!-- Mobile Card List (Screen < md, No scroll needed) -->
        <div class="block md:hidden divide-y divide-blue-100">
            <% if (containers && containers.length > 0) { %>
                <% containers.forEach(c => { %>
                    <div class="p-4 space-y-3">
                        <div class="flex items-start justify-between">
                            <div>
                                <div class="flex items-center space-x-2">
                                    <span class="status-dot <%= c.running ? 'running' : 'stopped' %>"></span>
                                    <h3 class="font-bold text-sm text-blue-900"><%= c.name %></h3>
                                </div>
                                <p class="text-xs font-mono text-blue-600 mt-1 pl-4 break-all"><%= c.image %></p>
                            </div>
                            <span class="text-xs font-semibold uppercase px-2 py-0.5 rounded <%= c.running ? 'bg-blue-50 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
                                <%= c.status %>
                            </span>
                        </div>

                        <% if (c.ports && c.ports.length > 0) { %>
                            <div class="flex flex-wrap gap-1 pl-4">
                                <% c.ports.forEach(p => { %>
                                    <span class="inline-block bg-blue-50 text-blue-800 text-xs px-1.5 py-0.5 rounded font-mono">
                                        <%= p.PublicPort ? `${p.IP}:${p.PublicPort}->${p.PrivatePort}` : p.PrivatePort %>/<%= p.Type %>
                                    </span>
                                <% }) %>
                            </div>
                        <% } %>

                        <div class="grid grid-cols-4 gap-1.5 pt-1">
                            <% if (c.running) { %>
                                <button onclick="controlContainer('<%= c.id %>', 'stop')" class="py-1.5 bg-red-50 hover:bg-red-100 text-red-600 font-semibold text-xs rounded-lg border border-red-200 text-center">Stop</button>
                            <% } else { %>
                                <button onclick="controlContainer('<%= c.id %>', 'start')" class="py-1.5 bg-green-50 hover:bg-green-100 text-green-700 font-semibold text-xs rounded-lg border border-green-200 text-center">Start</button>
                            <% } %>
                            <button onclick="controlContainer('<%= c.id %>', 'restart')" class="py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold text-xs rounded-lg border border-blue-200 text-center">Restart</button>
                            <button onclick="openEditModal('<%= c.id %>')" class="py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 font-semibold text-xs rounded-lg border border-amber-200 text-center">Edit</button>
                            <button onclick="deleteContainer('<%= c.id %>', '<%= c.name %>')" class="py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-xs rounded-lg text-center">Delete</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="p-8 text-center text-sm text-blue-400">
                    No containers found
                </div>
            <% } %>
        </div>

        <!-- Desktop Table View (Screen >= md) -->
        <div class="hidden md:block">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-blue-50/50 text-xs font-semibold text-blue-500 uppercase border-b border-blue-100">
                        <th class="px-6 py-3.5">Status</th>
                        <th class="px-6 py-3.5">Name</th>
                        <th class="px-6 py-3.5">Image</th>
                        <th class="px-6 py-3.5">Ports</th>
                        <th class="px-6 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-blue-100 text-sm">
                    <% if (containers && containers.length > 0) { %>
                        <% containers.forEach(c => { %>
                            <tr class="hover:bg-blue-50/20 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="flex items-center">
                                        <span class="status-dot <%= c.running ? 'running' : 'stopped' %> mr-2"></span>
                                        <span class="text-xs font-semibold uppercase text-blue-700"><%= c.status %></span>
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-semibold text-blue-900">
                                    <%= c.name %>
                                </td>
                                <td class="px-6 py-4 text-xs font-mono text-blue-700">
                                    <%= c.image %>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    <% if (c.ports && c.ports.length > 0) { %>
                                        <% c.ports.forEach(p => { %>
                                            <span class="inline-block bg-blue-50 text-blue-800 rounded px-1.5 py-0.5 mr-1 mb-1 font-mono">
                                                <%= p.PublicPort ? `${p.IP}:${p.PublicPort}->${p.PrivatePort}` : p.PrivatePort %>/<%= p.Type %>
                                            </span>
                                        <% }) %>
                                    <% } else { %>
                                        <span class="text-blue-300">-</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap text-xs font-medium">
                                    <div class="inline-flex items-center space-x-1.5">
                                        <% if (c.running) { %>
                                            <button onclick="controlContainer('<%= c.id %>', 'stop')" class="px-2.5 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200">Stop</button>
                                        <% } else { %>
                                            <button onclick="controlContainer('<%= c.id %>', 'start')" class="px-2.5 py-1 bg-green-100 text-green-700 rounded hover:bg-green-200">Start</button>
                                        <% } %>
                                        <button onclick="controlContainer('<%= c.id %>', 'restart')" class="px-2.5 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200">Restart</button>
                                        <button onclick="openEditModal('<%= c.id %>')" class="px-2.5 py-1 bg-amber-100 text-amber-700 rounded hover:bg-amber-200">Edit</button>
                                        <button onclick="deleteContainer('<%= c.id %>', '<%= c.name %>')" class="px-2.5 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-blue-400">
                                No containers found
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Container Modal (Create & Edit) -->
<div id="container-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
    <div class="bg-white rounded-2xl border border-blue-100 shadow-2xl max-w-lg w-full max-h-[92vh] flex flex-col my-auto overflow-hidden">
        <!-- Modal Header -->
        <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-blue-100 flex items-center justify-between bg-white flex-shrink-0">
            <h3 id="modal-title" class="text-base sm:text-lg font-bold text-blue-900">Create New Container</h3>
            <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100" aria-label="Close">
                <svg width="20" height="20" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Modal Form -->
        <form id="container-form" onsubmit="handleFormSubmit(event)" class="flex flex-col flex-1 overflow-hidden">
            <input type="hidden" id="edit-container-id" value="">

            <!-- Scrollable Content -->
            <div class="p-4 sm:p-6 overflow-y-auto space-y-3.5">
                <!-- Presets (Wrapped, no scroll) -->
                <div id="presets-section">
                    <label class="block text-xs font-semibold text-blue-700 uppercase tracking-wide mb-1.5">Quick Presets</label>
                    <div class="flex flex-wrap gap-1.5 text-xs">
                        <button type="button" onclick="selectPreset('nginx:latest', '8080:80')" class="px-2.5 py-1 font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg border border-blue-200">nginx</button>
                        <button type="button" onclick="selectPreset('redis:alpine', '6379:6379')" class="px-2.5 py-1 font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg border border-blue-200">redis</button>
                        <button type="button" onclick="selectPreset('mysql:8.0', '3306:3306', 'MYSQL_ROOT_PASSWORD=secret')" class="px-2.5 py-1 font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg border border-blue-200">mysql</button>
                        <button type="button" onclick="selectPreset('postgres:15-alpine', '5432:5432', 'POSTGRES_PASSWORD=secret')" class="px-2.5 py-1 font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg border border-blue-200">postgres</button>
                        <button type="button" onclick="selectPreset('mongo:latest', '27017:27017')" class="px-2.5 py-1 font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg border border-blue-200">mongodb</button>
                        <button type="button" onclick="selectPreset('node:alpine', '3000:3000')" class="px-2.5 py-1 font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg border border-blue-200">node</button>
                    </div>
                </div>

                <!-- Image -->
                <div>
                    <label for="form-image" class="block text-xs font-semibold text-gray-700 mb-1">Docker Image *</label>
                    <input type="text" id="form-image" name="image" required placeholder="e.g. nginx:latest, redis:alpine" class="w-full px-3 py-2 bg-blue-50/30 border border-blue-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <!-- Name -->
                <div>
                    <label for="form-name" class="block text-xs font-semibold text-gray-700 mb-1">Container Name (optional)</label>
                    <input type="text" id="form-name" name="name" placeholder="e.g. my-app" class="w-full px-3 py-2 bg-blue-50/30 border border-blue-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <!-- Port Mappings -->
                <div>
                    <label for="form-ports" class="block text-xs font-semibold text-gray-700 mb-1">Port Mapping (host:container)</label>
                    <input type="text" id="form-ports" name="ports" placeholder="e.g. 8080:80, 443:443" class="w-full px-3 py-2 bg-blue-50/30 border border-blue-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <!-- Environment Variables -->
                <div>
                    <label for="form-env" class="block text-xs font-semibold text-gray-700 mb-1">Environment Variables (KEY=VALUE per line)</label>
                    <textarea id="form-env" name="env" rows="2" placeholder="NODE_ENV=production&#10;PORT=3000" class="w-full px-3 py-2 bg-blue-50/30 border border-blue-200 rounded-xl text-xs sm:text-sm font-mono text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                </div>

                <!-- Volume Mounts -->
                <div>
                    <label for="form-volumes" class="block text-xs font-semibold text-gray-700 mb-1">Volume Mounts (host_path:container_path per line)</label>
                    <textarea id="form-volumes" name="volumes" rows="2" placeholder="/host/data:/data" class="w-full px-3 py-2 bg-blue-50/30 border border-blue-200 rounded-xl text-xs sm:text-sm font-mono text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                </div>

                <!-- Restart Policy & Auto Start -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                    <div>
                        <label for="form-restart" class="block text-xs font-semibold text-gray-700 mb-1">Restart Policy</label>
                        <select id="form-restart" name="restartPolicy" class="w-full px-3 py-2 bg-blue-50/30 border border-blue-200 rounded-xl text-sm text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="unless-stopped">unless-stopped</option>
                            <option value="always">always</option>
                            <option value="on-failure">on-failure</option>
                            <option value="no">no</option>
                        </select>
                    </div>
                    <div class="flex items-center space-x-2 pt-1 sm:pt-6">
                        <input type="checkbox" id="form-autostart" name="autoStart" checked class="w-4 h-4 text-blue-600 rounded border-blue-300 focus:ring-blue-500">
                        <label for="form-autostart" class="text-xs font-medium text-gray-700 select-none cursor-pointer">Start container immediately</label>
                    </div>
                </div>
            </div>

            <!-- Sticky Modal Footer -->
            <div class="px-4 sm:px-6 py-3 bg-slate-50/80 border-t border-blue-100 flex items-center justify-end space-x-2 flex-shrink-0">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-xs sm:text-sm text-gray-600 hover:bg-gray-100 rounded-xl font-medium">Cancel</button>
                <button type="submit" id="submit-btn" class="px-5 py-2 text-xs sm:text-sm bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white rounded-xl font-semibold shadow-sm flex items-center">
                    Create Container
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openModal(mode = 'create') {
        const modal = document.getElementById('container-modal');
        const title = document.getElementById('modal-title');
        const submitBtn = document.getElementById('submit-btn');
        const presets = document.getElementById('presets-section');

        if (mode === 'create') {
            document.getElementById('edit-container-id').value = '';
            document.getElementById('container-form').reset();
            title.innerText = 'Create New Container';
            submitBtn.innerText = 'Create Container';
            presets.classList.remove('hidden');
        }

        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    async function openEditModal(id) {
        openModal('edit');
        const title = document.getElementById('modal-title');
        const submitBtn = document.getElementById('submit-btn');
        const presets = document.getElementById('presets-section');
        
        title.innerText = 'Edit / Recreate Container';
        submitBtn.innerText = 'Update & Recreate';
        presets.classList.add('hidden');
        document.getElementById('edit-container-id').value = id;

        try {
            const res = await fetch(`/containers/api/${id}`);
            const data = await res.json();
            if (data && !data.error) {
                document.getElementById('form-name').value = data.name || '';
                document.getElementById('form-image').value = data.image || '';
                document.getElementById('form-ports').value = data.formattedPorts || '';
                document.getElementById('form-env').value = data.env || '';
                document.getElementById('form-volumes').value = data.volumes || '';
                document.getElementById('form-restart').value = data.restartPolicy || 'unless-stopped';
            } else {
                showAlert({ title: 'Error', text: 'Failed to load container details', type: 'error' });
            }
        } catch (e) {
            showAlert({ title: 'Error', text: 'Failed to connect to server', type: 'error' });
        }
    }

    function closeModal() {
        document.getElementById('container-modal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    // Close on outside click
    document.getElementById('container-modal')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeModal();
        }
    });

    function selectPreset(image, ports, env = '') {
        document.getElementById('form-image').value = image;
        document.getElementById('form-ports').value = ports;
        if (env) {
            document.getElementById('form-env').value = env;
        }
    }

    async function handleFormSubmit(e) {
        e.preventDefault();
        const editId = document.getElementById('edit-container-id').value;
        const isEdit = !!editId;
        const submitBtn = document.getElementById('submit-btn');

        submitBtn.disabled = true;
        submitBtn.innerText = isEdit ? 'Updating & recreating...' : 'Creating & pulling...';

        const payload = {
            image: document.getElementById('form-image').value,
            name: document.getElementById('form-name').value,
            ports: document.getElementById('form-ports').value,
            env: document.getElementById('form-env').value,
            volumes: document.getElementById('form-volumes').value,
            restartPolicy: document.getElementById('form-restart').value,
            autoStart: document.getElementById('form-autostart').checked
        };

        const endpoint = isEdit ? `/containers/api/${editId}/update` : '/containers/api/create';

        try {
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                showToast({ 
                    message: isEdit ? 'Container updated and recreated successfully' : 'Container created successfully', 
                    type: 'success' 
                });
                setTimeout(() => window.location.reload(), 600);
            } else {
                showAlert({ 
                    title: isEdit ? 'Update Failed' : 'Create Failed', 
                    text: data.error || 'Unknown error', 
                    type: 'error' 
                });
                submitBtn.disabled = false;
                submitBtn.innerText = isEdit ? 'Update & Recreate' : 'Create Container';
            }
        } catch (err) {
            showAlert({ title: 'Error', text: 'Failed to connect to server', type: 'error' });
            submitBtn.disabled = false;
            submitBtn.innerText = isEdit ? 'Update & Recreate' : 'Create Container';
        }
    }

    async function controlContainer(id, action) {
        try {
            const res = await fetch(`/containers/api/${id}/${action}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToast({ message: `Container ${action}ed successfully`, type: 'success' });
                setTimeout(() => window.location.reload(), 600);
            } else {
                showAlert({ title: 'Action Failed', text: data.error || 'Unknown error', type: 'error' });
            }
        } catch (e) {
            showAlert({ title: 'Error', text: 'Failed to send request', type: 'error' });
        }
    }

    async function deleteContainer(id, name = '') {
        const confirmed = await showConfirm({
            title: 'Delete Container?',
            text: `Are you sure you want to delete container ${name ? `"${name}"` : id}? This action cannot be undone.`,
            confirmText: 'Yes, Delete',
            cancelText: 'Cancel',
            type: 'danger'
        });

        if (!confirmed) return;

        try {
            const res = await fetch(`/containers/api/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                showToast({ message: 'Container deleted successfully', type: 'success' });
                setTimeout(() => window.location.reload(), 600);
            } else {
                showAlert({ title: 'Delete Failed', text: data.error || 'Unknown error', type: 'error' });
            }
        } catch (e) {
            showAlert({ title: 'Error', text: 'Failed to send request', type: 'error' });
        }
    }
</script>

<%- include('partials/footer') %>
