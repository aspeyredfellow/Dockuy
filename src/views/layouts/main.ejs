<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title.toLowerCase() %></title>
    <link rel="stylesheet" href="/css/tailwind.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .status-dot.running { background: #3b82f6; box-shadow: 0 0 8px rgba(59, 130, 246, 0.4); }
        .status-dot.stopped { background: #93c5fd; }
        .card-hover { transition: all 0.2s ease; }
        .card-hover:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(59,130,246,0.05); }
        .sidebar-link { transition: all 0.2s ease; }
        .sidebar-link:hover { background: rgba(59,130,246,0.05); color: #2563eb; }
        .sidebar-link.active { background: rgba(59,130,246,0.1); color: #2563eb; border-right: 3px solid #2563eb; }
    </style>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white text-blue-900">

    <div class="flex h-screen overflow-hidden">
        <%- include('../partials/sidebar') %>
        <div class="flex-1 flex flex-col overflow-hidden bg-blue-50/20">
            <%- include('../partials/header') %>
            <main class="flex-1 overflow-y-auto p-6">
                <%- body %>
            </main>
            <%- include('../partials/footer') %>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
