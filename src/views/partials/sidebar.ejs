<!-- Mobile backdrop overlay -->
<div id="sidebar-overlay" class="hidden"></div>

<aside id="sidebar" class="w-64 bg-white border-r border-blue-100 flex flex-col justify-between -translate-x-full md:translate-x-0">
    <div>
        <div class="p-6 border-b border-blue-100 flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-extrabold text-blue-600">dockuy</h1>
                <p class="text-xs text-blue-400 mt-0.5">Docker Manager</p>
            </div>
            <button id="close-sidebar-btn" class="md:hidden text-gray-400 hover:text-gray-600 p-1" aria-label="Close menu">
                <svg width="20" height="20" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        
        <nav class="p-4 space-y-1">
            <a href="/dashboard" class="sidebar-link flex items-center px-4 py-3 rounded-lg text-blue-700 font-medium <%= active === 'dashboard' ? 'active' : '' %>">
                <svg width="20" height="20" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z"></path></svg>
                Dashboard
            </a>
            <a href="/containers" class="sidebar-link flex items-center px-4 py-3 rounded-lg text-blue-700 font-medium <%= active === 'containers' ? 'active' : '' %>">
                <svg width="20" height="20" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                Containers
            </a>
            <a href="/images" class="sidebar-link flex items-center px-4 py-3 rounded-lg text-blue-700 font-medium <%= active === 'images' ? 'active' : '' %>">
                <svg width="20" height="20" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                Images
            </a>
        </nav>
    </div>
    
    <div class="p-4 border-t border-blue-100 text-xs text-blue-400">
        <div class="flex items-center justify-between mb-1">
            <span>Docker Status</span>
            <span class="flex items-center"><span class="status-dot running mr-1.5"></span>Connected</span>
        </div>
    </div>
</aside>
